{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventurefinder.local/contracts/afio-rpof/v0.1/dispatch-request.schema.json",
  "title": "AFIO RPOF dispatch request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "target",
    "group_by_affinity",
    "jobs"
  ],
  "properties": {
    "contract_version": {
      "const": "afio-rpof-dispatch-request/v0.1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fleet_key",
        "expected_fleet_id",
        "worker_indices"
      ],
      "properties": {
        "fleet_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "expected_fleet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "worker_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "group_by_affinity": {
      "type": "boolean"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "argv"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "affinity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
