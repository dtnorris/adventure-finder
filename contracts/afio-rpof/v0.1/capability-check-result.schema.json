{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventurefinder.local/contracts/afio-rpof/v0.1/capability-check-result.schema.json",
  "title": "AFIO RPOF capability check result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "ready",
    "fleet_key",
    "fleet_id",
    "selected_worker_indices",
    "capabilities",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "const": "afio-rpof-capability-check-result/v0.1"
    },
    "ready": {
      "type": "boolean"
    },
    "fleet_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "fleet_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "selected_worker_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "capabilities": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpu_id",
            "bootstrap_run_id",
            "models"
          ],
          "properties": {
            "gpu_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "bootstrap_run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "digest",
                  "context_length",
                  "fully_gpu_resident"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{64}$"
                  },
                  "context_length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fully_gpu_resident": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "billing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "tracked_elapsed_seconds",
        "current_tracked_hourly_rate_usd",
        "estimated_accrued_cost_usd"
      ],
      "properties": {
        "tracked_elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "current_tracked_hourly_rate_usd": {
          "type": "number",
          "minimum": 0
        },
        "estimated_accrued_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
