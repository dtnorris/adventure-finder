#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "pathname"

ROOT = Pathname.new(__dir__).join("..").expand_path
CODE_ROOT = Pathname.new(ENV.fetch("AF_PROJECT_ROOT", "/Users/davidnorris/code/adventure-finder-components")).expand_path

if %w[start resume bind-successor-version successor-version-authority prepare-workload
      plan-local-capabilities local-start local-resume local-status].include?(ARGV.first)
  $LOAD_PATH.unshift(ROOT.join("lib").to_s)
  require "adventure_finder_catalog_ingest"
  exit AdventureFinderWorkspace::CatalogIngestCLI.run(
    ARGV,
    front_door_root: ENV.fetch("AF_ADVENTURE_FINDER_ROOT", ROOT.to_s),
    project_root: CODE_ROOT
  )
end

if ARGV.first == "final-promotion"
  require "optparse"
  $LOAD_PATH.unshift(ROOT.join("lib").to_s)
  require "adventure_finder_final_promotion"

  begin
    ARGV.shift
    options = {}
    OptionParser.new do |parser|
      parser.banner = "Usage: bin/af-catalog final-promotion --inputs INPUTS.json --package PACKAGE.json --approver NAME [options]"
      parser.on("--inputs PATH") { |value| options[:inputs_path] = value }
      parser.on("--package PATH") { |value| options[:package_path] = value }
      parser.on("--approver NAME") { |value| options[:approver] = value }
      parser.on("--operation-dir PATH") { |value| options[:operation_dir] = value }
      parser.on("--preview") { options[:preview] = true }
    end.parse!(ARGV)
    required = %i[inputs_path package_path approver]
    missing = required.reject { |key| options[key] }
    raise OptionParser::MissingArgument, missing.map { |key| "--#{key.to_s.tr('_', '-')}" }.join(", ") unless missing.empty?
    raise OptionParser::InvalidArgument, "unexpected arguments: #{ARGV.join(' ')}" unless ARGV.empty?

    front_door = AdventureFinderWorkspace::FinalPromotion.new(
      front_door_root: ENV.fetch("AF_ADVENTURE_FINDER_ROOT", ROOT.to_s),
      project_root: CODE_ROOT,
      pipeline_root: ENV["AF_DATA_PIPELINE_ROOT"]
    )
    exit front_door.run(**options)
  rescue AdventureFinderWorkspace::Error, OptionParser::ParseError => e
    warn "af-catalog: #{e.message}"
    exit 2
  end
end

PDF_CONVERTER_ROOT = Pathname.new(
  ENV.fetch("AF_PDF_CONVERTER_ROOT", CODE_ROOT.join("pdf-to-llm-md-converter").to_s)
).expand_path
DATA_PIPELINE_ROOT = Pathname.new(
  ENV.fetch("AF_DATA_PIPELINE_ROOT", CODE_ROOT.join("af-data-pipeline").to_s)
).expand_path

def abort_with(message, status = 1)
  warn "af-catalog: #{message}"
  exit status
end

def executable!(path, label)
  abort_with("#{label} not found or not executable: #{path}") unless path.file? && path.executable?
end

def stream_command(env, *command)
  receipt = nil
  status = nil

  Open3.popen2e(env, *command.map(&:to_s)) do |_stdin, output, wait_thread|
    line_buffer = +""

    begin
      loop do
        chunk = output.readpartial(4096)
        $stdout.write(chunk)
        $stdout.flush

        line_buffer << chunk
        while (newline = line_buffer.index("\n"))
          line = line_buffer.slice!(0..newline)
          if (match = line.match(/\AConversion receipt:\s+(.+?)\s*\z/))
            receipt = Pathname.new(match[1]).expand_path
          end
        end
      end
    rescue EOFError
      if (match = line_buffer.match(/\AConversion receipt:\s+(.+?)\s*\z/))
        receipt = Pathname.new(match[1]).expand_path
      end
    end

    status = wait_thread.value
  end

  [status, receipt]
end

pdf = ARGV.shift
abort_with("usage: bin/af-catalog INPUT.pdf") unless pdf
abort_with("unexpected arguments: #{ARGV.join(' ')}") unless ARGV.empty?

pdf = Pathname.new(pdf).expand_path
abort_with("input PDF does not exist: #{pdf}") unless pdf.file?
abort_with("input must be a .pdf file: #{pdf}") unless pdf.extname.casecmp?(".pdf")

converter = PDF_CONVERTER_ROOT.join("bin", "convert-cached")
router = DATA_PIPELINE_ROOT.join("bin", "af-ingest-next")
executable!(converter, "cached PDF converter")
executable!(router, "ingestion next-action router")

# Admit explicit AF state before the converter can publish owner artifacts.
# The legacy one-shot command itself creates no AF coordination records.
require_relative "../lib/adventure_finder_state_paths"
begin
  AdventureFinderWorkspace::StatePaths.root(
    front_door_root: ENV.fetch("AF_ADVENTURE_FINDER_ROOT", ROOT.to_s),
    project_root: CODE_ROOT, owner_roots: [PDF_CONVERTER_ROOT, DATA_PIPELINE_ROOT]
  )
rescue AdventureFinderWorkspace::Error => error
  abort_with(error.message)
end

build_dir = PDF_CONVERTER_ROOT.join("build")
venv_bin = PDF_CONVERTER_ROOT.join(".venv", "bin")
env = {
  "AF_PROJECT_ROOT" => CODE_ROOT.to_s,
  "AF_ADVENTURE_FINDER_ROOT" => ENV.fetch("AF_ADVENTURE_FINDER_ROOT", ROOT.to_s)
}
if venv_bin.directory?
  current_path = ENV.fetch("PATH", "")
  env["PATH"] = [venv_bin.to_s, current_path].reject(&:empty?).join(File::PATH_SEPARATOR)
end

puts "AdventureFinder catalog ingest"
puts "  PDF: #{pdf}"
puts "  Converter: #{converter}"
puts "  Router: #{router}"
puts

conversion_status, receipt = stream_command(
  env,
  converter,
  pdf,
  "--output-dir",
  build_dir
)

unless receipt&.file?
  abort_with(
    "converter did not report a durable conversion receipt; " \
    "conversion exit status was #{conversion_status.exitstatus}",
    conversion_status.success? ? 1 : conversion_status.exitstatus
  )
end

puts
puts "Routing durable conversion state..."
puts

router_ok = system(env, router.to_s, receipt.to_s, "--pdf-converter-root", PDF_CONVERTER_ROOT.to_s)
router_status = $?

unless router_ok
  code = router_status&.exitstatus || 1
  abort_with("ingestion router failed with exit status #{code}", code)
end

exit conversion_status.exitstatus unless conversion_status.success?
