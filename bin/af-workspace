#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "pathname"
require "json"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "adventure_finder_workspace"
require "adventure_finder_production_context"
require "adventure_finder_diagnostics"

module AdventureFinderWorkspace
  class CLI
    def initialize(argv)
      @argv = argv.dup
      @manifest_path = Pathname(File.expand_path("../repos.yml", __dir__))
    end

    def run
      command = @argv.shift
      return usage(0) if command.nil? || %w[-h --help help].include?(command)

      manifest = Manifest.new(@manifest_path)
      case command
      when "bootstrap" then bootstrap(manifest)
      when "status"    then status(manifest)
      when "sync"      then sync(manifest)
      when "test"      then test(manifest)
      when "doctor"    then doctor(manifest)
      when "snapshot"  then snapshot(manifest)
      when "context"   then context(manifest)
      else
        warn "Unknown command: #{command}"
        usage(2)
      end
    rescue Error => e
      warn "ERROR: #{e.message}"
      2
    rescue OptionParser::ParseError => e
      warn "ERROR: #{e.message}"
      2
    end

    private

    def common_options(manifest)
      {
        root: ENV.fetch("AF_PROJECT_ROOT", manifest.workspace_root_default),
        adjacent_root: ENV["AF_ADJACENT_ROOT"],
        all: false,
        core: false
      }
    end

    def add_selection_options(parser, options)
      parser.on("--root PATH", "Workspace root (default: AF_PROJECT_ROOT or manifest default)") { |v| options[:root] = v }
      parser.on("--adjacent-root PATH", "Outside repositories (default: AF_ADJACENT_ROOT or front-door parent)") { |v| options[:adjacent_root] = v }
      parser.on("--all", "Include archived/experimental repositories") { options[:all] = true }
      parser.on("--core", "Only repositories tagged core") { options[:core] = true }
    end

    def selected(manifest, options)
      raise Error, "--all and --core are mutually exclusive" if options[:all] && options[:core]
      manifest.selected(all: options[:all], core: options[:core])
    end

    def bootstrap(manifest)
      options = common_options(manifest).merge(
        protocol: ENV.fetch("AF_GIT_PROTOCOL", "ssh"),
        setup: false
      )
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace bootstrap [options]"
        add_selection_options(p, options)
        p.on("--protocol PROTOCOL", %w[ssh https], "Clone protocol: ssh or https (default: ssh)") { |v| options[:protocol] = v }
        p.on("--setup", "Run each repository's lightweight setup command after clone") { options[:setup] = true }
      end
      parser.parse!(@argv)

      workspace = Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root])
      workspace.bootstrap(repos: selected(manifest, options), protocol: options[:protocol], setup: options[:setup]) ? 0 : 1
    end

    def status(manifest)
      options = common_options(manifest)
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace status [options]"
        add_selection_options(p, options)
      end
      parser.parse!(@argv)
      Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root]).print_status(repos: selected(manifest, options))
      0
    end

    def sync(manifest)
      options = common_options(manifest)
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace sync [options]"
        add_selection_options(p, options)
      end
      parser.parse!(@argv)
      Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root]).sync(repos: selected(manifest, options)) ? 0 : 1
    end

    def test(manifest)
      options = common_options(manifest).merge(fail_fast: false, jobs: 1, comprehensive: false,
        front_door_root: ENV.fetch("AF_ADVENTURE_FINDER_ROOT", File.expand_path("..", __dir__)))
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace test [options]"
        add_selection_options(p, options)
        p.on("--front-door-root PATH", "Detached front-door root (default: AF_ADVENTURE_FINDER_ROOT or this checkout)") { |v| options[:front_door_root] = v }
        p.on("--comprehensive", "Also run offline cross-component operator acceptance") { options[:comprehensive] = true }
        p.on("-j N", "--jobs N", Integer, "Run up to N repository test suites concurrently (default: 1)") { |v| options[:jobs] = v }
        p.on("--fail-fast", "Stop after the first missing/failing suite (requires --jobs 1)") { options[:fail_fast] = true }
      end
      parser.parse!(@argv)
      Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root], front_door_root: options[:front_door_root]).test(
        repos: selected(manifest, options),
        fail_fast: options[:fail_fast],
        jobs: options[:jobs],
        comprehensive: options[:comprehensive]
      ) ? 0 : 1
    end

    def doctor(manifest)
      return diagnostic_doctor(manifest) if Diagnostics::SUBJECT_TYPES.include?(@argv.first)

      options = common_options(manifest).merge(strict: false)
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace doctor [options]"
        add_selection_options(p, options)
        p.on("--strict", "Treat warnings (including missing optional runtime tools) as failure") { options[:strict] = true }
      end
      parser.parse!(@argv)
      Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root]).doctor(
        repos: selected(manifest, options),
        strict: options[:strict]
      ) ? 0 : 1
    end

    def diagnostic_doctor(manifest)
      type = @argv.shift
      options = {
        registry: File.expand_path("../config/production_contexts.yml", __dir__),
        root: common_options(manifest).fetch(:root), json: false, logs: false,
        lines: nil
      }
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-doctor job BATCH JOB|pod POD|fleet FLEET|campaign FLEET [options]"
        p.on("--registry PATH", "Production context registry") { |v| options[:registry] = v }
        p.on("--root PATH", "Workspace root") { |v| options[:root] = v }
        p.on("--json", "Emit machine-readable JSON") { options[:json] = true }
        p.on("--logs", "Show bounded retained evidence") { options[:logs] = true }
        p.on("--lines N", Integer, "Tail N lines (maximum 200)") { |v| options[:lines] = v }
      end
      parser.parse!(@argv)
      if options[:lines] && !options[:logs]
        raise OptionParser::InvalidArgument, "--lines requires --logs"
      end
      diagnostics = Diagnostics.new(
        registry_path: options[:registry], workspace_root: options[:root]
      )
      result = diagnostics.call(type, @argv, logs: options[:logs], lines: options[:lines])
      options[:json] ? puts(JSON.pretty_generate(result)) : diagnostics.render(result, logs: options[:logs])
      0
    end

    def snapshot(manifest)
      options = common_options(manifest).merge(output: nil)
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-workspace snapshot [options]"
        add_selection_options(p, options)
        p.on("--output PATH", "Output YAML path (default: snapshots/<timestamp>.yml)") { |v| options[:output] = v }
      end
      parser.parse!(@argv)
      output = options[:output] || File.join(
        File.expand_path("..", __dir__),
        "snapshots",
        "workspace-#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}.yml"
      )
      Workspace.new(manifest: manifest, root: options[:root], adjacent_root: options[:adjacent_root]).snapshot(
        repos: selected(manifest, options),
        output_path: output
      )
      0
    end

    def context(manifest)
      options = {
        registry: File.expand_path("../config/production_contexts.yml", __dir__),
        root: common_options(manifest).fetch(:root),
        json: false,
        verify: false
      }
      parser = OptionParser.new do |p|
        p.banner = "Usage: bin/af-context batch 39 [--json] [--verify]"
        p.on("--registry PATH", "Production context registry") { |v| options[:registry] = v }
        p.on("--root PATH", "Workspace root (default: AF_PROJECT_ROOT or manifest default)") { |v| options[:root] = v }
        p.on("--json", "Emit machine-readable JSON") { options[:json] = true }
        p.on("--verify", "Verify registered local artifacts without mutating them") { options[:verify] = true }
      end
      parser.parse!(@argv)
      raise OptionParser::InvalidArgument, "expected HANDLE TYPE and NAME (for example: batch 39)" unless @argv.length == 2

      type, name = @argv
      registry = ProductionContextRegistry.new(options[:registry], workspace_root: options[:root])
      context = registry.resolve(type, name)
      failures = options[:verify] ? registry.verify(type, name) : []
      payload = context.merge("verification" => {"ok" => failures.empty?, "failures" => failures}) if options[:verify]
      payload ||= context
      if options[:json]
        puts JSON.pretty_generate(payload)
      else
        render_context_human(type.downcase, name, payload)
      end
      failures.empty? ? 0 : 1
    end

    def render_context_human(type, name, context)
      case type
      when "batch"
        puts "Batch: #{name}"
        puts "Workload: #{context.fetch('production_batch_id')}"
        puts "AFW: #{context.dig('afw', 'repository_root')}"
        puts "Plan: #{relative_context_path(context.dig('afw', 'plan_path'), context.dig('afw', 'repository_root'))}"
        puts "Plan SHA: #{context.dig('plan', 'sha256')[0, 12]}…"
        puts "WLO: #{context.dig('wlo', 'repository_root')}"
        puts "Output: #{relative_context_path(context.dig('wlo', 'output_root'), context.dig('wlo', 'repository_root'))}"
        puts "Fleet: #{context.fetch('associated_fleets').join(', ')}"
      when "fleet"
        puts "Fleet: #{name}"
        puts "Campaign: #{context.fetch('campaign_id')}"
        puts "RPOF: #{context.dig('rpof', 'repository_root')}"
        puts "Campaign file: #{relative_context_path(context.dig('rpof', 'campaign_path'), context.dig('rpof', 'repository_root'))}"
        puts "Budget: #{relative_context_path(context.dig('rpof', 'budget_path'), context.dig('rpof', 'repository_root'))}"
        puts "State: #{relative_context_path(context.dig('rpof', 'state_root'), context.dig('rpof', 'repository_root'))}"
        puts "Batch: #{context.fetch('associated_batches').join(', ')}"
      end

      verification = context["verification"]
      return unless verification

      puts "Verified: #{verification.fetch('ok') ? 'yes' : 'no'}"
      verification.fetch("failures").each { |failure| puts "  - #{failure}" }
    end

    def relative_context_path(path, root)
      Pathname(path).relative_path_from(Pathname(root)).to_s
    rescue ArgumentError
      path
    end

    def usage(code)
      puts <<~TEXT
        AdventureFinder workspace orchestration

        Usage:
          bin/af-workspace bootstrap [--setup] [--core|--all]
          bin/af-workspace status [--core|--all]
          bin/af-workspace sync [--core|--all]
          bin/af-workspace test [-j N|--jobs N] [--fail-fast] [--comprehensive] [--core|--all]
          bin/af-workspace doctor [--strict] [--core|--all]
          bin/af-doctor job 39 JOB [--logs] [--lines N] [--json]
          bin/af-doctor pod POD [--logs] [--lines N] [--json]
          bin/af-doctor fleet FLEET [--json]
          bin/af-doctor campaign FLEET [--json]
          bin/af-workspace snapshot [--output PATH] [--core|--all]
          bin/af-context batch 39 [--json] [--verify]
          bin/af-context fleet A [--json] [--verify]
          bin/af-batch start 39
          bin/af-batch resume 39
          bin/af-batch retry 39 JOB [JOB ...] --reason TEXT [--dry-run]
          bin/af-batch recovery 39

        Defaults:
          component root: AF_PROJECT_ROOT, otherwise /Users/davidnorris/code/adventure-finder-components
          repository set: current/default repos in repos.yml
          clone protocol: AF_GIT_PROTOCOL, otherwise ssh

        Safety:
          af-batch start/resume are foreground WLO owners; Ctrl-C cancels only
          that execution. Retry is selected/audited; recovery is read-only.
          None tears down or changes provider capacity.
          sync always fetches first, skips pull on dirty/detached/no-upstream repos,
          and only uses `git pull --ff-only`. It never resets, stashes, commits, or pushes.
      TEXT
      code
    end
  end
end

exit AdventureFinderWorkspace::CLI.new(ARGV).run
