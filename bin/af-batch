#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "adventure_finder_batch"

options = {
  registry: File.expand_path("../config/production_contexts.yml", __dir__),
  root: ENV.fetch("AF_PROJECT_ROOT", "/Users/davidnorris/code")
}
parser = OptionParser.new do |entry|
  entry.banner = "Usage: bin/af-batch start|resume HANDLE [--root PATH] [--registry PATH]"
  entry.on("--root PATH", "Workspace root (default: AF_PROJECT_ROOT)") { |value| options[:root] = value }
  entry.on("--registry PATH", "Production context registry") { |value| options[:registry] = value }
  entry.separator ""
  entry.separator "Process ownership:"
  entry.separator "  start   FOREGROUND WORK OWNER; opens the frozen batch without resume/retry."
  entry.separator "  resume  FOREGROUND WORK OWNER; explicitly clears WLO pause only."
  entry.separator "  Ctrl-C cancels this WLO execution via scoped FO-06 process-group handling."
  entry.separator "  Neither command creates, changes, or tears down provider capacity."
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "expected start|resume HANDLE" unless ARGV.length == 2

  action, handle = ARGV
  front_door = AdventureFinderWorkspace::BatchFrontDoor.new(
    registry_path: options.fetch(:registry), workspace_root: options.fetch(:root)
  )
  exit front_door.run(action, handle)
rescue AdventureFinderWorkspace::Error, OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  exit 2
end
