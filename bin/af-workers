#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "adventure_finder_worker_registry_front_door"

options = {
  registry: File.expand_path("../config/production_contexts.yml", __dir__),
  root: ENV.fetch("AF_PROJECT_ROOT", "/Users/davidnorris/code"),
  state_root: nil,
  json: false
}
parser = OptionParser.new do |entry|
  entry.banner = "Usage: bin/af-workers batch HANDLE --json [options]"
  entry.on("--root PATH", "Workspace root (default: AF_PROJECT_ROOT)") { |value| options[:root] = value }
  entry.on("--registry PATH", "Production context registry") { |value| options[:registry] = value }
  entry.on("--state-root PATH", "Merged publisher state root") { |value| options[:state_root] = value }
  entry.on("--json", "Emit dynamic-worker-registry/v0.1 JSON") { options[:json] = true }
end

begin
  parser.parse!(ARGV)
  unless ARGV.length == 2 && ARGV[0] == "batch" && options[:json]
    raise OptionParser::InvalidArgument, "expected: batch HANDLE --json"
  end
  registry = AdventureFinderWorkspace::ProductionContextRegistry.new(
    options.fetch(:registry), workspace_root: options.fetch(:root)
  )
  document = AdventureFinderWorkspace::WorkerRegistryFrontDoor.new(registry:).snapshot(
    ARGV.fetch(1), state_root: options[:state_root]
  )
  puts JSON.generate(document)
  exit 0
rescue AdventureFinderWorkspace::Error, OptionParser::ParseError => e
  warn "ERROR: #{e.message}"
  exit 2
end
